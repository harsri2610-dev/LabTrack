# ---- MongoDB ----
MONGO_INITDB_ROOT_USERNAME=admin
MONGO_INITDB_ROOT_PASSWORD=changeme
MONGO_PORT=27017
MONGODB_URI=mongodb://admin:changeme@mongo:27017/diagnostic_lab?authSource=admin
MONGODB_DB=diagnostic_lab

# ---- Redis ----
REDIS_PORT=6379

# ---- Backend ----
NODE_ENV=development
PORT=4000
REDIS_URL=redis://redis:6379
JWT_ACCESS_SECRET=replace_with_long_random_string
JWT_REFRESH_SECRET=replace_with_another_long_random_string
# Set locally to a random value of at least 32 characters for one-time admin setup.
ADMIN_BOOTSTRAP_TOKEN=
JWT_ACCESS_EXPIRES=15m
JWT_REFRESH_EXPIRES=7d
CORS_ORIGIN=http://localhost:5173

# ---- Frontend ----
VITE_API_URL=http://localhost:4000/api
